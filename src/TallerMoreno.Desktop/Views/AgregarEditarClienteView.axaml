<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TallerMoreno.Desktop.Views.AgregarEditarClienteView"
        Title="{Binding Titulo}"
        Width="620" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="White">
  <StackPanel Margin="32,28">
    <TextBlock Classes="titulo-ventana" Text="{Binding Titulo}"/>
    <TextBlock Classes="subtitulo" Text="Solo el nombre es obligatorio." Margin="0,0,0,8"/>

    <TextBlock Classes="etiqueta" Text="Nombre *"/>
    <TextBox x:Name="txtNombre" Text="{Binding Form.Nombre}" Watermark="Ej: Carlos Pérez"/>

    <Grid ColumnDefinitions="*,16,*">
      <StackPanel>
        <TextBlock Classes="etiqueta" Text="Celular"/>
        <TextBox Text="{Binding Form.Telefono}" Watermark="Ej: 300 123 4567"/>
      </StackPanel>
      <StackPanel Grid.Column="2">
        <TextBlock Classes="etiqueta" Text="Cédula o NIT"/>
        <TextBox Text="{Binding Form.Documento}"/>
      </StackPanel>
    </Grid>

    <Grid ColumnDefinitions="110,16,*,16,140">
      <StackPanel>
        <TextBlock Classes="etiqueta" Text="Placa"/>
        <TextBox Text="{Binding Form.Placa}" Watermark="ABC123"/>
      </StackPanel>
      <StackPanel Grid.Column="2">
        <TextBlock Classes="etiqueta" Text="Vehículo"/>
        <TextBox Text="{Binding Form.Vehiculo}" Watermark="Ej: Chevrolet Spark 2015"/>
      </StackPanel>
      <StackPanel Grid.Column="4">
        <TextBlock Classes="etiqueta" Text="Kilometraje"/>
        <NumericUpDown Value="{Binding Kilometraje}" Minimum="0" Maximum="3000000" FormatString="N0"
                       ShowButtonSpinner="False" Watermark="Ej: 85.000"/>
      </StackPanel>
    </Grid>

    <TextBlock Classes="etiqueta" Text="Notas"/>
    <TextBox Text="{Binding Form.Notas}" AcceptsReturn="True" TextWrapping="Wrap" Height="72"
             VerticalContentAlignment="Top" Padding="14,10"/>

    <Border Classes="error" Margin="0,16,0,0"
            IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <TextBlock Text="{Binding ErrorMessage}"/>
    </Border>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,24,0,0">
      <Button Classes="secundario" Content="Cancelar" Width="140" IsCancel="True" Command="{Binding CancelCommand}"/>
      <Button Content="Guardar" Width="160" IsDefault="True" Command="{Binding SaveCommand}"/>
    </StackPanel>
  </StackPanel>
</Window>
