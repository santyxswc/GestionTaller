<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TallerMoreno.Desktop.Views.AgregarEditarProveedorView"
        Title="{Binding Titulo}"
        Width="620" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="White">
  <StackPanel Margin="32,28">
    <TextBlock Classes="titulo-ventana" Text="{Binding Titulo}"/>
    <TextBlock Classes="subtitulo" Text="Solo el nombre es obligatorio." Margin="0,0,0,8"/>

    <TextBlock Classes="etiqueta" Text="Nombre *"/>
    <TextBox x:Name="txtNombre" Text="{Binding Form.Nombre}" Watermark="Ej: Repuestos El Cruce"/>

    <Grid ColumnDefinitions="*,16,*">
      <StackPanel>
        <TextBlock Classes="etiqueta" Text="Celular o teléfono"/>
        <TextBox Text="{Binding Form.Telefono}"/>
      </StackPanel>
      <StackPanel Grid.Column="2">
        <TextBlock Classes="etiqueta" Text="Persona de contacto"/>
        <TextBox Text="{Binding Form.Contacto}"/>
      </StackPanel>
    </Grid>

    <Grid ColumnDefinitions="*,16,*">
      <StackPanel>
        <TextBlock Classes="etiqueta" Text="NIT"/>
        <TextBox Text="{Binding Form.Nit}"/>
      </StackPanel>
      <StackPanel Grid.Column="2">
        <TextBlock Classes="etiqueta" Text="Correo"/>
        <TextBox Text="{Binding Form.Correo}"/>
      </StackPanel>
    </Grid>

    <TextBlock Classes="etiqueta" Text="Dirección"/>
    <TextBox Text="{Binding Form.Direccion}"/>

    <TextBlock Classes="etiqueta" Text="Notas"/>
    <TextBox Text="{Binding Form.Notas}" AcceptsReturn="True" TextWrapping="Wrap" Height="72"
             VerticalContentAlignment="Top" Padding="14,10"/>

    <Border Classes="error" Margin="0,16,0,0"
            IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <TextBlock Text="{Binding ErrorMessage}"/>
    </Border>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,24,0,0">
      <Button Classes="secundario" Content="Cancelar" Width="140" IsCancel="True" Command="{Binding CancelCommand}"/>
      <Button Content="Guardar" Width="160" IsDefault="True" Command="{Binding SaveCommand}"/>
    </StackPanel>
  </StackPanel>
</Window>
