<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TallerMoreno.Desktop.Views.CambiarClaveView"
        Title="{Binding Titulo}"
        Width="460" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="White">
  <StackPanel Margin="32,28">
    <TextBlock Classes="titulo-ventana" Text="{Binding Titulo}" TextWrapping="Wrap"/>
    <TextBlock Classes="subtitulo" Text="Mínimo 4 caracteres." Margin="0,0,0,8"/>

    <StackPanel IsVisible="{Binding PideActual}">
      <TextBlock Classes="etiqueta" Text="Contraseña actual"/>
      <TextBox PasswordChar="•" Text="{Binding Actual}"/>
    </StackPanel>

    <TextBlock Classes="etiqueta" Text="Contraseña nueva"/>
    <TextBox PasswordChar="•" Text="{Binding Nueva}"/>

    <TextBlock Classes="etiqueta" Text="Repite la contraseña nueva"/>
    <TextBox PasswordChar="•" Text="{Binding Repetir}"/>

    <Border Classes="error" Margin="0,16,0,0"
            IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <TextBlock Text="{Binding ErrorMessage}"/>
    </Border>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,24,0,0">
      <Button Classes="secundario" Content="Cancelar" Width="130" IsCancel="True" Command="{Binding CancelCommand}"/>
      <Button Content="Guardar" Width="150" IsDefault="True" Command="{Binding GuardarCommand}"/>
    </StackPanel>
  </StackPanel>
</Window>
