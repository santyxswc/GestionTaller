<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TallerMoreno.Desktop.Views.DevolucionView"
        Title="{Binding Titulo}"
        Width="640" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="White">
  <StackPanel Margin="32,28">
    <TextBlock Classes="titulo-ventana" Text="{Binding Titulo}" TextWrapping="Wrap"/>
    <TextBlock Classes="subtitulo" Text="{Binding Subtitulo}" TextWrapping="Wrap"/>

    <!-- Repuesto y unidades -->
    <Grid ColumnDefinitions="*,16,120" IsVisible="{Binding PideDetalle}">
      <StackPanel>
        <TextBlock Classes="etiqueta" Text="Repuesto"/>
        <ComboBox ItemsSource="{Binding Lineas}" SelectedItem="{Binding Linea}" HorizontalAlignment="Stretch"
                  IsVisible="{Binding EligeDeVenta}">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock>
                <Run Text="{Binding Nombre}" FontWeight="SemiBold"/>
                <Run Text="{Binding PorDevolver, StringFormat=' · {0} und.'}" Foreground="{StaticResource TextoSuaveBrush}"/>
              </TextBlock>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <AutoCompleteBox ItemsSource="{Binding Repuestos}" SelectedItem="{Binding Repuesto, Mode=TwoWay}"
                         FilterMode="Custom" ItemFilter="{Binding FiltroRepuestos}" MinimumPrefixLength="1"
                         ValueMemberBinding="{Binding Nombre}" Watermark="Escribe el nombre o código"
                         IsVisible="{Binding EligeDelInventario}">
          <AutoCompleteBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,4">
                <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Stock, StringFormat='Hay {0} unid.'}" FontSize="13"
                           Foreground="{StaticResource TextoSuaveBrush}"/>
              </StackPanel>
            </DataTemplate>
          </AutoCompleteBox.ItemTemplate>
        </AutoCompleteBox>
      </StackPanel>
      <StackPanel Grid.Column="2">
        <TextBlock Classes="etiqueta" Text="Unidades"/>
        <NumericUpDown Value="{Binding Cantidad}" Minimum="1" Increment="1" FormatString="N0"/>
      </StackPanel>
    </Grid>

    <StackPanel IsVisible="{Binding PideDetalle}">
      <TextBlock Classes="etiqueta" Text="Motivo"/>
      <ListBox Classes="chips" ItemsSource="{Binding Motivos}" SelectedItem="{Binding Motivo}"/>
    </StackPanel>

    <TextBlock Classes="etiqueta" Text="{Binding EtiquetaResultado}"/>
    <ListBox Classes="chips" ItemsSource="{Binding Resultados}" SelectedItem="{Binding Resultado}"/>
    <TextBlock Classes="ayuda" Text="{Binding AyudaResultado}" TextWrapping="Wrap" Margin="2,2,0,0"
               IsVisible="{Binding AyudaResultado, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

    <StackPanel IsVisible="{Binding PideValor}">
      <TextBlock Classes="etiqueta" Text="{Binding EtiquetaValor}"/>
      <NumericUpDown Value="{Binding Valor}" Minimum="0" Increment="10000" FormatString="N0" Width="260" HorizontalAlignment="Left"/>
    </StackPanel>

    <StackPanel IsVisible="{Binding PideDetalle}" Margin="0,16,0,0">
      <CheckBox IsChecked="{Binding MueveInventario}" Content="{Binding TextoInventario}" FontSize="15"/>
      <TextBlock Classes="ayuda" Text="{Binding AyudaInventario}" TextWrapping="Wrap" Margin="30,0,0,0"/>
    </StackPanel>

    <TextBlock Classes="etiqueta" Text="Notas"/>
    <TextBox Text="{Binding Notas}" Watermark="Opcional, por ejemplo qué falla tenía"/>

    <Border Classes="error" Margin="0,16,0,0"
            IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"/>
    </Border>

    <Grid ColumnDefinitions="Auto,*" Margin="0,24,0,0">
      <Button Classes="secundario" Content="Borrar" Foreground="{StaticResource PeligroBrush}"
              IsVisible="{Binding PuedeBorrar}" Command="{Binding BorrarCommand}"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
        <Button Classes="secundario" Content="Cancelar" Width="130" IsCancel="True" Command="{Binding CancelarCommand}"/>
        <Button Classes="exito" Content="{Binding TextoGuardar}" Command="{Binding GuardarCommand}"/>
      </StackPanel>
    </Grid>
  </StackPanel>
</Window>
