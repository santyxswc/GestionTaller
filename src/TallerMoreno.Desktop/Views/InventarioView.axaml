<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:TallerMoreno.Desktop.Views"
             x:Class="TallerMoreno.Desktop.Views.InventarioView"
             x:Name="raiz">
  <DockPanel Margin="32,28,20,0">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto">
      <StackPanel>
        <TextBlock Classes="titulo-pagina" Text="Inventario"/>
        <TextBlock Classes="subtitulo" Text="{Binding Resumen}"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <Button Classes="secundario" Content="📥  Descargar Excel" Command="{Binding ExcelCommand}"/>
        <Button Classes="secundario" Content="🚚  Llegó mercancía" Command="{Binding LlegoMercanciaCommand}"/>
        <Button Content="＋  Nuevo repuesto" IsVisible="{Binding EsAdmin}" Command="{Binding NuevoCommand}"/>
      </StackPanel>
    </Grid>

    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,18,12,12">
      <TextBox Classes="buscador" Text="{Binding Busqueda}" Watermark="🔍  Buscar por nombre, código, marca o ubicación"/>
      <ToggleButton Grid.Column="1" Margin="10,0,0,0" MinHeight="54" Padding="20,0" CornerRadius="14"
                    FontSize="16" FontWeight="SemiBold" IsChecked="{Binding SoloPorPedir}"
                    Content="⚠️  Solo por pedir"/>
    </Grid>
    <ListBox DockPanel.Dock="Top" Classes="chips" ItemsSource="{Binding Categorias}" SelectedItem="{Binding Categoria}"/>

    <Panel>
      <TextBlock IsVisible="{Binding SinResultados}" Classes="subtitulo" HorizontalAlignment="Center"
                 Margin="0,60,0,0" Text="No hay repuestos para mostrar."/>
      <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,4,0,24">
        <ItemsControl ItemsSource="{Binding Repuestos}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Classes="tarjeta" Margin="0,0,14,14"
                      Command="{Binding #raiz.DataContext.AbrirCommand}" CommandParameter="{Binding}">
                <v:TarjetaRepuesto/>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Panel>
  </DockPanel>
</UserControl>
