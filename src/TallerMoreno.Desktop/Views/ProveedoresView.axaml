<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TallerMoreno.Desktop.Views.ProveedoresView">
  <DockPanel Margin="32,28,32,24">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto">
      <StackPanel>
        <TextBlock Classes="titulo-pagina" Text="Proveedores"/>
        <TextBlock Classes="subtitulo" Text="{Binding Resumen}"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <Button Classes="secundario" Content="🚚  Llegó mercancía" Command="{Binding LlegoMercanciaCommand}"/>
        <Button Content="＋  Nuevo proveedor" Command="{Binding NuevoCommand}"/>
      </StackPanel>
    </Grid>

    <TextBox DockPanel.Dock="Top" Classes="buscador" Margin="0,18,0,16" Text="{Binding Busqueda}"
             Watermark="🔍  Buscar por nombre, NIT, contacto o teléfono"/>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="10" Margin="0,16,0,0">
      <Button Content="📦  Entradas y pagos" Command="{Binding EntradasCommand}"/>
      <Button Classes="exito" Content="💵  Registrar pago" Command="{Binding PagarCommand}"/>
      <Button Classes="secundario" Content="✏️  Editar" Command="{Binding EditarCommand}"/>
      <Button Classes="secundario" Content="Eliminar" Foreground="{StaticResource PeligroBrush}"
              IsVisible="{Binding EsAdmin}" Command="{Binding EliminarCommand}"/>
    </StackPanel>

    <Panel>
      <Border Classes="tarjeta" ClipToBounds="True" IsVisible="{Binding !SinResultados}">
        <DataGrid x:Name="tabla" ItemsSource="{Binding Proveedores}" SelectedItem="{Binding Seleccionado}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="2*" MinWidth="170"/>
            <DataGridTextColumn Header="Total comprado" Binding="{Binding TotalComprado, StringFormat='{}{0:C0}'}" Width="Auto"/>
            <DataGridTextColumn Header="Pagado" Binding="{Binding TotalPagado, StringFormat='{}{0:C0}'}" Width="Auto"/>
            <DataGridTemplateColumn Header="Le debes" Width="Auto" SortMemberPath="Deuda">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Classes="deuda" Classes.debe="{Binding TieneDeuda}" Text="{Binding DeudaTexto}"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono}" Width="Auto"/>
            <DataGridTextColumn Header="Última entrada" Binding="{Binding UltimaEntrada, StringFormat='{}{0:dd/MM/yyyy}'}" Width="Auto"/>
          </DataGrid.Columns>
        </DataGrid>
      </Border>
      <TextBlock IsVisible="{Binding SinResultados}" Classes="subtitulo" HorizontalAlignment="Center"
                 Margin="0,60,0,0" Text="No hay proveedores para mostrar."/>
    </Panel>
  </DockPanel>
</UserControl>
