<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:TallerMoreno.Desktop.Converters"
             x:Class="TallerMoreno.Desktop.Views.TarjetaRepuesto"
             Width="200">
  <!-- Tarjeta de un repuesto: foto, nombre, precio y unidades. DataContext: Repuesto -->
  <Grid RowDefinitions="130,Auto">
    <Border CornerRadius="16,16,0,0" ClipToBounds="True" Background="#F2F2F7">
      <Panel>
        <Image Source="{Binding Categoria, Converter={x:Static conv:Convertidores.ImagenCategoria}}"
               Stretch="UniformToFill" IsVisible="{Binding !TieneFoto}"/>
        <Image Source="{Binding Foto, Converter={x:Static conv:Convertidores.Foto}}" Stretch="UniformToFill"
               IsVisible="{Binding TieneFoto}"/>
      </Panel>
    </Border>
    <StackPanel Grid.Row="1" Margin="14,10,14,14" Spacing="2">
      <TextBlock Text="{Binding Nombre}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                 MaxLines="2" TextTrimming="CharacterEllipsis" Height="42" LineHeight="21"/>
      <TextBlock Text="{Binding Marca}" FontSize="13" Foreground="{StaticResource TextoSuaveBrush}"
                 TextTrimming="CharacterEllipsis" Height="18"/>
      <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
        <TextBlock Text="{Binding PrecioVenta, StringFormat='{}{0:C0}'}" FontSize="18" FontWeight="Bold"
                   LetterSpacing="-0.3" VerticalAlignment="Center"/>
        <Border Grid.Column="1" Classes="stock" Classes.poco="{Binding StockBajo}" Classes.agotado="{Binding Agotado}">
          <Panel>
            <TextBlock Text="{Binding Stock, StringFormat='{}{0} unid.'}" IsVisible="{Binding !Agotado}"/>
            <TextBlock Text="Agotado" IsVisible="{Binding Agotado}"/>
          </Panel>
        </Border>
      </Grid>
    </StackPanel>
  </Grid>
</UserControl>
